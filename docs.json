{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SenderKit",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/templates",
              "concepts/variables",
              "concepts/versioning",
              "concepts/environments",
              "concepts/channels-and-providers",
              "concepts/sending",
              "concepts/messages",
              "concepts/ai-authoring"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "sdks/typescript"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/installation",
              "cli/context",
              "cli/send",
              "cli/templates",
              "cli/messages"
            ]
          },
          {
            "group": "MCP Server",
            "pages": [
              "mcp/overview",
              "mcp/quickstart",
              "mcp/installation",
              "mcp/tools"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/overview",
              "guides/http-api",
              "guides/welcome-email",
              "guides/stripe-lifecycle",
              "guides/team-invites",
              "guides/supabase-notifications",
              "guides/ai-agent",
              "guides/agent-skills"
            ]
          },
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "https://www.senderkit.com/openapi.yaml"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://www.senderkit.com/app/dashboard",
          "icon": "gauge"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/package/@senderkit/sdk",
          "icon": "npm"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@senderkit.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://www.senderkit.com/app/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/senderkit",
      "github": "https://github.com/senderkit"
    }
  }
}
